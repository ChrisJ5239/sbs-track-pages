{"evidence_kind":"task_transcription","record":{"api_period_metadata":null,"cumulative_context":{"original_text":"З початку жовтня (01–23.10) підрозділи угруповання СБС уразили 49 923 цілі противника, з них 12 627 одиниць особового складу.","period_end":"2026-10-23","period_start":"2026-10-01"},"date_basis":"原帖日级区段“Протягом доби”；月累计区段“01–23.10”截至该统计日；与2026年10月相邻官方日期、2026-10-23 Madyar署期及本次执行日交叉核对，不按发布时间倒推。","eligible":true,"flags":["页面仅显示时间04:59，未显示可验证的完整发布日期及时区；published_at=null。","原帖未公布总摧毁、受伤及出动架次；对应字段为null。","火炮及其中自行火炮为包含关系，不重复相加。"],"metric_evidence":{"antennas_hit":{"kind":"explicit","original_label":"125 антен ворожих екіпажів"},"artillery_reported_hit":{"kind":"explicit","original_label":"16 артилерійських систем"},"automotive_reported_hit":{"kind":"explicit","original_label":"114 одиниць автомобільної, спеціальної та інженерної техніки"},"depots_hit":{"kind":"explicit","original_label":"17 складів"},"drone_launch_positions_hit":{"kind":"explicit","original_label":"61 точка вильоту дронів"},"enemy_uavs_total_hit":{"kind":"explicit","original_label":"488 безпілотних літальних апаратів противника типу «коптер», «крило», «шахед» та «гербера»"},"ew_radar_comms_reported_hit":{"kind":"explicit","original_label":"12 РЛС та засобів РЕБ"},"personnel_hit":{"kind":"explicit","original_label":"701 одиниця особового складу"},"personnel_killed":{"kind":"explicit","original_label":"з них 336 ліквідовано"},"self_propelled_artillery_hit":{"kind":"explicit","original_label":"зокрема 1 САУ"},"tanks_hit":{"kind":"explicit","original_label":"2 танки"},"targets_hit":{"kind":"explicit","original_label":"Загалом протягом доби уражено 2 364 цілі противника"}},"metrics":{"antennas_hit":125,"artillery_reported_hit":16,"automotive_reported_hit":114,"depots_hit":17,"drone_launch_positions_hit":61,"enemy_uavs_total_hit":488,"ew_radar_comms_reported_hit":12,"personnel_hit":701,"personnel_killed":336,"personnel_wounded":null,"recon_missions":null,"self_propelled_artillery_hit":1,"strike_missions":null,"tanks_hit":2,"targets_destroyed":null,"targets_hit":2364},"observed_at":"2026-10-24T14:04:06+08:00","original_text":"⚡️ Новий абсолютний добовий рекорд СБС — 701 уражений окупант\nЗагалом протягом доби уражено 2 364 цілі противника.\nСеред уражених цілей:\n⚡️ 701 одиниця особового складу, з них 336 ліквідовано;\n61 точка вильоту дронів;\n125 антен ворожих екіпажів;\n12 РЛС та засобів РЕБ;\n114 одиниць автомобільної, спеціальної та інженерної техніки;\n2 танки;\n16 артилерійських систем, зокрема 1 САУ;\n17 складів;\n488 безпілотних літальних апаратів противника типу «коптер», «крило», «шахед» та «гербера».\nЗ початку жовтня (01–23.10) підрозділи угруповання СБС уразили 49 923 цілі противника, з них 12 627 одиниць особового складу.\n☠ СБС: На крок попереду!\nПідписатись на офіційний телеграм-канал Сил безпілотних систем","original_text_complete":true,"page_url":"https://t.me/s/usf_army","period_kind":"daily","published_at":null,"raw_api_response":null,"scope":"usf_grouping","source":"telegram_usf","source_key":"usf_army/2578","source_period_end":null,"source_period_start":null,"source_updated_at":null,"source_url":"https://t.me/usf_army/2578","stat_date":"2026-10-23","status":"published","unmapped_categories":[],"visible_post_time":"04:59"}}