{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbs:source-record:1.0",
  "title": "SBS official public daily claims source record",
  "description": "Official Ukrainian SBS claims; not independent verification. Null means undisclosed, never zero.",
  "type": "object",
  "required": [
    "schema_version",
    "parser_version",
    "source",
    "source_key",
    "source_url",
    "stat_date",
    "scope",
    "period_kind",
    "status",
    "eligible",
    "metrics",
    "metric_evidence",
    "flags"
