      "const": "1.0"
    },
    "parser_version": {
      "type": "string"
    },
    "source": {
      "enum": [
        "telegram_usf",
        "telegram_madyar",
        "website"
      ]
    },
    "source_key": {
      "type": "string"
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "stat_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "scope": {
      "const": "usf_grouping"
    },
    "period_kind": {
      "const": "daily"
    },
    "published_at": {
      "type": [
        "string",
        "null"
